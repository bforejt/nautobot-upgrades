<mxfile host="app.diagrams.net" type="device">
  <diagram name="9800 WLC upgrade overview" id="c9800-upgrade-overview">
    <mxGraphModel dx="1000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1"
        connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="Select controller(s) + target version&amp;#10;(Full: ONE controller, picked explicitly)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="160" y="50" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="gcbefore" value="Opt-in, once per RUN: Golden Config backup of&amp;#10;every controller BEFORE any upgrade starts&amp;#10;(fail-closed: can&#x27;t back up → nothing is touched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;dashed=1;" vertex="1" parent="1"><mxGeometry x="140" y="150" width="400" height="72" as="geometry"/></mxCell>
        <mxCell id="connect" value="Connect &amp; authenticate&amp;#10;(RESTCONF over HTTPS, creds from Nautobot Secrets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="261" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="gates" value="Pre-flight gates&amp;#10;≥ 17.9.1 · install mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="369" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_topo" value="Positively&amp;#10;STANDALONE?&amp;#10;(one chassis,&amp;#10;active, ready)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="466" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="echo" value="Blast-radius echo (also in dry-run):&amp;#10;joined APs + models + how many have a&amp;#10;backup controller (device-published prime info)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="585" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_clean" value="Clean device first&amp;#10;opted in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="682" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="freespace" value="Free-space gate&amp;#10;(on the cleaned flash when cleaning ran)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="829" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_dry" value="Dry-run?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="926" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="copy" value="Transfer image + verify exact size&amp;#10;(async xcopy by default, ledger-tracked;&amp;#10;classic copy = fallback tier; skipped if already on flash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="1045" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_stagecopy" value="Run scope =&amp;#10;Step 1 (copy) only?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="1142" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="add" value="install add — extract &amp; stage the bundle&amp;#10;(gate → track via the device&#x27;s ledger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="1261" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="learn" value="LEARN the target&#x27;s AP image version from&amp;#10;the device (the staged bundle publishes it —&amp;#10;rebuild letters OK) + model-coverage advisory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="1369" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_stageadd" value="Run scope =&amp;#10;Steps 1 &amp; 2&amp;#10;(copy + prep)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="1466" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="predl" value="AP PREDOWNLOAD: snapshot the joined-AP&amp;#10;roster (the contract) → fire → watch the&amp;#10;controller&#x27;s per-AP status to completion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="1585" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_complete" value="EVERY roster AP&amp;#10;holds the target?&amp;#10;(per-AP complete, or&amp;#10;already in backup&amp;#10;partition)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="1682" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="d_stagepre" value="Run scope =&amp;#10;Steps 1-3&amp;#10;(predownload)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="1790" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="d_healthpre" value="Health checks&amp;#10;opted in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="1898" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="d_savepre" value="Save config before&amp;#10;reload opted in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="2034" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="activate" value="Activate (non-ISSU) → controller reloads;&amp;#10;EVERY joined AP reboots to swap to its&amp;#10;predownloaded partition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="2181" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_boot" value="Controller booted&amp;#10;the target &amp;&amp;#10;came back?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="2278" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="commit" value="install commit — CONTROLLER-side facts only&amp;#10;(AP rejoin NEVER gates the commit:&amp;#10;refusing would guarantee a second fleet outage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="2397" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="sync" value="Sync Nautobot software version&amp;#10;(the controller record now shows the new OS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="2505" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="rejoin" value="AP rejoin report (REPORT-ONLY): who is back&amp;#10;on the target, who is downloading (slow path),&amp;#10;who is missing (maybe on its backup controller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="150" y="2613" width="380" height="66" as="geometry"/></mxCell>
        <mxCell id="d_savepost" value="Save config after&amp;#10;commit opted in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="2710" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="d_cleanup" value="Remove inactive&amp;#10;opted in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="2846" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="d_healthpost" value="Health checks&amp;#10;opted in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E8EEF6;strokeColor=#3C6CA8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="2982" width="260" height="88" as="geometry"/></mxCell>
        <mxCell id="done" value="DONE: Upgraded &amp; committed ✓&amp;#10;(the fleet rebooted once, image pre-staged)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="3134" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="gcafter" value="Opt-in, once per RUN: Golden Config backup&amp;#10;again AFTER all controllers finish (runs even&amp;#10;if some failed; warn-only — never un-succeeds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;dashed=1;" vertex="1" parent="1"><mxGeometry x="140" y="3234" width="400" height="72" as="geometry"/></mxCell>
        <mxCell id="d_topo_term" value="Predownload/Full REFUSED, naming what was&amp;#10;read (HA SSO orchestration is unvalidated;&amp;#10;silence is never standalone) — staging&amp;#10;scopes proceed with a warning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="590" y="474" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_clean_term" value="Reclaim flash up front (install remove&amp;#10;inactive; never in a dry-run) before the&amp;#10;free-space gate evaluates what&#x27;s left" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="590" y="690" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_dry_term" value="DONE: Dry-run — every pre-flight gate&amp;#10;evaluated, roster + echo previewed;&amp;#10;no changes made" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="934" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_stagecopy_term" value="DONE: Staged (Step 1) — image&amp;#10;copied to bootflash; nothing else" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1150" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_stageadd_term" value="DONE: Staged (Steps 1 &amp; 2) — added&amp;#10;&amp; marked for activation; not reloaded" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1474" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_complete_term" value="The deadline DECLARES FAILURE, naming&amp;#10;each incomplete/vanished AP — nothing&amp;#10;activates (the named-exception checkboxes&amp;#10;are the deliberate overrides — tolerate&amp;#10;applies to Full runs; stragglers take the&amp;#10;slow post-reload path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="590" y="1690" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_stagepre_term" value="DONE: PREDOWNLOADED — every joined AP&amp;#10;holds the image; the window run needs&amp;#10;only Full (activate → reload → commit)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1798" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_healthpre_term" value="Pre-test: baseline the AP roster, per-AP&amp;#10;versions, radio states, reload reason&amp;#10;(a failed read aborts BEFORE activate)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="590" y="1906" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_savepre_term" value="Save the running config (the activation&amp;#10;reload never prompts — unsaved changes&amp;#10;would be lost); the device&#x27;s RPC result verifies" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="590" y="2042" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_boot_term" value="Auto-rollback to the previous image —&amp;#10;NOT committed (a rollback would reboot&amp;#10;the AP fleet a second time)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="590" y="2286" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_savepost_term" value="Save again on the NEW OS — normalizes&amp;#10;startup to the new version&#x27;s rendering&amp;#10;(soak trade-off in the README; default off)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="590" y="2718" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_cleanup_term" value="install remove inactive — reclaim flash&amp;#10;space (old packages &amp; prior images);&amp;#10;gated &amp; tracked like every engine write" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="590" y="2854" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="d_healthpost_term" value="Post-test: compare vs the baseline (AP roster&amp;#10;as a NAMED set difference · per-AP versions ·&amp;#10;radios up-before · reload reason; report-only)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6B7B;" vertex="1" parent="1"><mxGeometry x="590" y="2990" width="330" height="72" as="geometry"/></mxCell>
